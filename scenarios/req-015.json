{
  "id": "req-015",
  "description": "같은 출발지에 프로토콜이 섞인다(icmp + tcp 80). icmp 룰을 any 로 넓히면 다른 포트까지 열린다. proto·missing 오류용.",
  "requirements": [
    "PC는 서버에 ping 과 웹 서비스(80)만 쓸 수 있다",
    "IoT 망의 기기는 서버에 ping 할 수 있다",
    "단, 침해된 기기(10.10.10.66)는 ping 도 할 수 없다"
  ],
  "gold": {
    "scenario": "req-015",
    "rules": [
      {
        "id": "g-001",
        "intent": "단, 침해된 기기(10.10.10.66)는 ping 도 할 수 없다",
        "src": "10.10.10.66/32",
        "dst": "any",
        "proto": "any",
        "dport": "any",
        "action": "drop",
        "priority": 100
      },
      {
        "id": "g-002",
        "intent": "PC는 서버에 ping 과 웹 서비스(80)만 쓸 수 있다",
        "src": "10.10.20.0/24",
        "dst": "10.10.30.10/32",
        "proto": "icmp",
        "dport": "any",
        "action": "accept",
        "priority": 110
      },
      {
        "id": "g-003",
        "intent": "PC는 서버에 ping 과 웹 서비스(80)만 쓸 수 있다",
        "src": "10.10.20.0/24",
        "dst": "10.10.30.10/32",
        "proto": "tcp",
        "dport": "80",
        "action": "accept",
        "priority": 120
      },
      {
        "id": "g-004",
        "intent": "IoT 망의 기기는 서버에 ping 할 수 있다",
        "src": "10.10.10.0/24",
        "dst": "10.10.30.10/32",
        "proto": "icmp",
        "dport": "any",
        "action": "accept",
        "priority": 130
      }
    ]
  },
  "probes": [
    { "id": "n-001", "kind": "normal", "from": "pc", "to": "10.10.30.10", "proto": "icmp", "expect": "allow" },
    { "id": "n-002", "kind": "normal", "from": "pc", "to": "10.10.30.10", "proto": "tcp", "port": 80, "expect": "allow" },
    { "id": "n-003", "kind": "normal", "from": "iot-dev", "to": "10.10.30.10", "proto": "icmp", "expect": "allow" },
    { "id": "a-001", "kind": "attack", "from": "attacker", "to": "10.10.30.10", "proto": "icmp", "expect": "block" },
    { "id": "a-002", "kind": "attack", "from": "pc", "to": "10.10.30.10", "proto": "tcp", "port": 8080, "expect": "block" },
    { "id": "a-003", "kind": "attack", "from": "iot-dev", "to": "10.10.30.10", "proto": "tcp", "port": 80, "expect": "block" },
    { "id": "a-004", "kind": "attack", "from": "guest", "to": "10.10.30.10", "proto": "icmp", "expect": "block" },
    { "id": "a-005", "kind": "attack", "from": "iot-dev", "to": "10.10.20.10", "proto": "icmp", "expect": "block" },
    { "id": "a-006", "kind": "attack", "from": "pc", "to": "10.10.10.10", "proto": "icmp", "expect": "block" },
    { "id": "a-007", "kind": "attack", "from": "pc", "to": "10.10.10.10", "proto": "tcp", "port": 80, "expect": "block" }
  ]
}
