# 랩 토폴로지 정의. up.sh / down.sh 가 읽는다.
IMAGE=fwlab

# 이름 서브넷(앞 3옥텟)
NETWORKS="iot:10.10.10 lan:10.10.20 svc:10.10.30"

# fw 는 각 네트워크의 .254
FW_HOST=254

# 이름:네트워크:호스트번호:실행명령
HOSTS="
iot-dev:iot:10:python3 -m http.server 80
attacker:iot:66:sleep infinity
pc:lan:10:sleep infinity
server:svc:10:sh -c 'python3 -m http.server 80 & python3 -m http.server 8080 & wait'
"
