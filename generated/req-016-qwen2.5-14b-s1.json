{
  "scenario": "req-016",
  "rules": [
    {
      "id": "r-001",
      "intent": "Allow IoT devices to ping internal and server networks",
      "src": "10.10.10.0/24",
      "dst": "any",
      "proto": "icmp",
      "dport": "any",
      "action": "accept",
      "priority": 1
    },
    {
      "id": "r-002",
      "intent": "Allow IoT devices to access server update port",
      "src": "10.10.10.0/24",
      "dst": "10.10.30.10",
      "proto": "tcp",
      "dport": "8080",
      "action": "accept",
      "priority": 2
    },
    {
      "id": "r-003",
      "intent": "Block compromised IoT device from accessing internal and server networks",
      "src": "10.10.10.66",
      "dst": "10.10.20.0/24",
      "proto": "any",
      "dport": "any",
      "action": "drop",
      "priority": 0
    },
    {
      "id": "r-004",
      "intent": "Block compromised IoT device from accessing server network",
      "src": "10.10.10.66",
      "dst": "10.10.30.0/24",
      "proto": "any",
      "dport": "any",
      "action": "drop",
      "priority": 0
    }
  ]
}
