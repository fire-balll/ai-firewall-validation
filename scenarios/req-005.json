{
  "id": "req-005",
  "description": "관리 페이지 접근 출발지를 LAN 으로 제한한다. src → any widen 오류용.",
  "requirements": [
    "IoT 기기의 관리 페이지(80)는 PC에서만 접근할 수 있다",
    "서버는 IoT 기기의 관리 페이지에 접근할 수 없다"
  ],
  "gold": {
    "scenario": "req-005",
    "rules": [
      {
        "id": "g-001",
        "intent": "IoT 기기의 관리 페이지(80)는 PC에서만 접근할 수 있다",
        "src": "10.10.20.0/24",
        "dst": "10.10.10.10/32",
        "proto": "tcp",
        "dport": "80",
        "action": "accept",
        "priority": 100
      }
    ]
  },
  "probes": [
    { "id": "n-001", "kind": "normal", "from": "pc", "to": "10.10.10.10", "proto": "tcp", "port": 80, "expect": "allow" },
    { "id": "a-001", "kind": "attack", "from": "server", "to": "10.10.10.10", "proto": "tcp", "port": 80, "expect": "block" },
    { "id": "a-002", "kind": "attack", "from": "iot-dev", "to": "10.10.30.10", "proto": "tcp", "port": 80, "expect": "block" }
  ]
}
