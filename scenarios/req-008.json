{
  "id": "req-008",
  "description": "ICMP 만 다룬다. proto icmp → any 확대 오류용.",
  "requirements": [
    "PC는 IoT 망과 서버 망에 ping 할 수 있다",
    "IoT 기기는 어디에도 ping 할 수 없다"
  ],
  "gold": {
    "scenario": "req-008",
    "rules": [
      {
        "id": "g-001",
        "intent": "PC는 IoT 망과 서버 망에 ping 할 수 있다 (IoT 망)",
        "src": "10.10.20.0/24",
        "dst": "10.10.10.0/24",
        "proto": "icmp",
        "dport": "any",
        "action": "accept",
        "priority": 100
      },
      {
        "id": "g-002",
        "intent": "PC는 IoT 망과 서버 망에 ping 할 수 있다 (서버 망)",
        "src": "10.10.20.0/24",
        "dst": "10.10.30.0/24",
        "proto": "icmp",
        "dport": "any",
        "action": "accept",
        "priority": 110
      }
    ]
  },
  "probes": [
    { "id": "n-001", "kind": "normal", "from": "pc", "to": "10.10.10.10", "proto": "icmp", "expect": "allow" },
    { "id": "n-002", "kind": "normal", "from": "pc", "to": "10.10.30.10", "proto": "icmp", "expect": "allow" },
    { "id": "a-001", "kind": "attack", "from": "attacker", "to": "10.10.20.10", "proto": "icmp", "expect": "block" },
    { "id": "a-002", "kind": "attack", "from": "iot-dev", "to": "10.10.30.10", "proto": "icmp", "expect": "block" },
    { "id": "a-003", "kind": "attack", "from": "pc", "to": "10.10.30.10", "proto": "tcp", "port": 80, "expect": "block" }
  ]
}
