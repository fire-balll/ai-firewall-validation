{
  "scenario": "req-020",
  "rules": [
    {
      "id": "r-001",
      "intent": "서버의 관리 포트(8080)는 관리자 PC(10.10.20.10)만 접근할 수 있다.",
      "src": "10.10.20.10/32",
      "dst": "10.10.30.10/32",
      "proto": "tcp",
      "dport": "8080",
      "action": "accept",
      "priority": 1
    },
    {
      "id": "r-002",
      "intent": "서버의 관리 포트(8080)는 다른 PC와 다른 망은 접근할 수 없다.",
      "src": "any",
      "dst": "10.10.30.10/32",
      "proto": "tcp",
      "dport": "8080",
      "action": "drop",
      "priority": 2
    },
    {
      "id": "r-003",
      "intent": "서버의 웹 서비스(80)는 PC 망의 모든 PC가 접근할 수 있다.",
      "src": "10.10.20.0/24",
      "dst": "10.10.30.10/32",
      "proto": "tcp",
      "dport": "80",
      "action": "accept",
      "priority": 3
    }
  ]
}
