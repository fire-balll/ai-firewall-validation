{
  "scenario": "req-016",
  "rules": [
    {
      "id": "r-001",
      "intent": "IoT 망의 기기는 서버의 업데이트 포트(8080)를 쓸 수 있다",
      "src": "10.10.10.0/24",
      "dst": "10.10.30.10",
      "proto": "tcp",
      "dport": "8080",
      "action": "accept",
      "priority": 1
    },
    {
      "id": "r-002",
      "intent": "IoT 망의 기기는 PC 망과 서버 망에 ping 할 수 있다",
      "src": "10.10.10.0/24",
      "dst": "10.10.20.0/24",
      "proto": "icmp",
      "dport": "any",
      "action": "accept",
      "priority": 2
    },
    {
      "id": "r-003",
      "intent": "IoT 망의 기기는 서버 망에 ping 할 수 있다",
      "src": "10.10.10.0/24",
      "dst": "10.10.30.0/24",
      "proto": "icmp",
      "dport": "any",
      "action": "accept",
      "priority": 2
    },
    {
      "id": "r-004",
      "intent": "침해된 기기(10.10.10.66)는 PC 망과 서버 망 어디에도 접속할 수 없다",
      "src": "10.10.10.66",
      "dst": "10.10.20.0/24",
      "proto": "any",
      "dport": "any",
      "action": "drop",
      "priority": 0
    },
    {
      "id": "r-005",
      "intent": "침해된 기기(10.10.10.66)는 서버 망과 접속할 수 없다",
      "src": "10.10.10.66",
      "dst": "10.10.30.0/24",
      "proto": "any",
      "dport": "any",
      "action": "drop",
      "priority": 0
    }
