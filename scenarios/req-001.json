{
  "id": "req-001",
  "description": "기본 망 분리. 허용할 통신만 열고 IoT 발 신규 연결은 default deny 로 막는다.",
  "requirements": [
    "PC는 서버의 웹 서비스(80)에 접근할 수 있다",
    "PC는 IoT 기기의 관리 페이지(80)에 접근할 수 있다",
    "IoT 기기는 내부 PC와 서버에 먼저 접속할 수 없다"
  ],
  "gold": {
    "scenario": "req-001",
    "rules": [
      {
        "id": "g-001",
        "intent": "PC는 서버의 웹 서비스(80)에 접근할 수 있다",
        "src": "10.10.20.0/24",
        "dst": "10.10.30.10/32",
        "proto": "tcp",
        "dport": "80",
        "action": "accept",
        "priority": 100
      },
      {
        "id": "g-002",
        "intent": "PC는 IoT 기기의 관리 페이지(80)에 접근할 수 있다",
        "src": "10.10.20.0/24",
        "dst": "10.10.10.10/32",
        "proto": "tcp",
        "dport": "80",
        "action": "accept",
        "priority": 110
      }
    ]
  },
  "probes": [
    { "id": "n-001", "kind": "normal", "from": "pc", "to": "10.10.30.10", "proto": "tcp", "port": 80, "expect": "allow" },
    { "id": "n-002", "kind": "normal", "from": "pc", "to": "10.10.10.10", "proto": "tcp", "port": 80, "expect": "allow" },
    { "id": "a-001", "kind": "attack", "from": "iot-dev", "to": "10.10.30.10", "proto": "tcp", "port": 80, "expect": "block" },
    { "id": "a-002", "kind": "attack", "from": "attacker", "to": "10.10.30.10", "proto": "tcp", "port": 8080, "expect": "block" },
    { "id": "a-003", "kind": "attack", "from": "attacker", "to": "10.10.20.10", "proto": "icmp", "expect": "block" },
    { "id": "a-004", "kind": "attack", "from": "iot-dev", "to": "10.10.20.10", "proto": "icmp", "expect": "block" }
  ]
}
