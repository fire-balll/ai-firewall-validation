    { "id": "n-002", "kind": "normal", "from": "pc", "to": "10.10.10.10", "proto": "tcp", "port": 80, "expect": "allow" },
    { "id": "n-003", "kind": "normal", "from": "iot-dev", "to": "10.10.30.10", "proto": "tcp", "port": 8080, "expect": "allow" },
    { "id": "n-004", "kind": "normal", "from": "pc", "to": "10.10.30.10", "proto": "icmp", "expect": "allow" },
    { "id": "n-005", "kind": "normal", "from": "pc", "to": "10.10.10.10", "proto": "icmp", "expect": "allow" },
